diff --git a/editor/scene/3d/node_3d_editor_plugin.cpp b/editor/scene/3d/node_3d_editor_plugin.cpp
index 512c0f54dc..002b359f79 100644
--- a/editor/scene/3d/node_3d_editor_plugin.cpp
+++ b/editor/scene/3d/node_3d_editor_plugin.cpp
@@ -127,7 +127,12 @@ constexpr float ZOOM_FREELOOK_MAX = 10'000;
 #endif
 
 constexpr real_t MIN_Z = 0.01;
-constexpr real_t MAX_Z = 1000000.0;
+
+#ifdef REAL_T_IS_DOUBLE
+constexpr real_t MAX_Z = 100'000'000.0;
+#else
+constexpr real_t MAX_Z = 1'000'000.0;
+#endif
 
 constexpr real_t MIN_FOV = 0.01;
 constexpr real_t MAX_FOV = 179;
